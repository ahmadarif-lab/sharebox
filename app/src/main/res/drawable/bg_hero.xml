<?xml version="1.0" encoding="utf-8"?>
<!-- Gradient yang sama dengan tombol utama di web UI: cukup gelap supaya teks putih
     lolos WCAG AA (6.3:1 di ujung biru, 6.5:1 di ujung violet). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="315"
        android:startColor="#2F52D9"
        android:centerColor="#4A46DC"
        android:endColor="#6A3FD0" />
</shape>
